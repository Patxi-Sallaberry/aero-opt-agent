# ─────────────────────────────────────────────────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# .env est ignoré par git — ne JAMAIS committer de clé.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Agent LLM (Phase 4) -------------------------------------
# Clé API Anthropic pour l'orchestrateur.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle utilisé par l'orchestrateur.
AGENT_MODEL=claude-opus-5
# Budget maximum d'itérations d'optimisation par run.
MAX_ITERATIONS=20

# --- Fusion 360 (Phase 1) ------------------------------------
# Chemin du fichier seed paramétrique fourni par l'utilisateur.
FUSION_SEED_PATH=fusion/seed_design.f3d
# Exécutable Fusion 360 (laisser vide si le driver est lancé
# manuellement depuis l'add-in Scripts de Fusion).
FUSION_EXE_PATH=
# Nom du composant / design cible dans le document Fusion.
FUSION_DESIGN_NAME=wing_v01

# --- OpenFOAM (Phase 2) --------------------------------------
# Script d'environnement OpenFOAM à sourcer avant tout run.
FOAM_BASHRC=/opt/openfoam12/etc/bashrc
# Répertoire du case template.
OPENFOAM_TEMPLATE_DIR=openfoam/templates
# Nombre de cœurs pour la décomposition parallèle.
OPENFOAM_NPROCS=4

# --- Pipeline / chemins --------------------------------------
# Fichier de configuration piloté par l'agent (SEUL fichier qu'il édite).
DESIGN_PARAMS_PATH=configs/design_params.yaml
# Paramètres CFD (jamais modifiés par l'agent).
CFD_SETTINGS_PATH=configs/cfd_settings.yaml
# Racine d'archivage des itérations.
ITERATIONS_DIR=data/iterations

# --- Divers --------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
