# ─────────────────────────────────────────────────────────────
# Copier ce fichier vers .env et remplir les valeurs.
# .env est ignoré par git — ne JAMAIS committer de clé.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Agent LLM (Phase 4) -------------------------------------
# Clé API Anthropic pour l'orchestrateur.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle utilisé par l'orchestrateur.
AGENT_MODEL=claude-opus-5
# Budget maximum d'itérations d'optimisation par run.
MAX_ITERATIONS=20

# --- Fusion 360 (Phase 1) ------------------------------------
# Chemin du fichier seed paramétrique fourni par l'utilisateur.
FUSION_SEED_PATH=fusion/seed_design.f3d
# Exécutable Fusion 360 (laisser vide si le driver est lancé
# manuellement depuis l'add-in Scripts de Fusion).
FUSION_EXE_PATH=
# Nom du composant / design cible dans le document Fusion.
FUSION_DESIGN_NAME=wing_v01
# Stratégie de géométrie :
#   rebuild    = reconstruit la géométrie depuis design_params.yaml (défaut,
#                requis par le seed livré qui n'est pas réellement paramétrique)
#   parameters = met à jour les User Parameters et laisse Fusion recalculer
FUSION_GEOMETRY_MODE=rebuild
# Qui produit la géométrie :
#   auto     = Fusion si l'API est disponible, producteur interne sinon (défaut)
#   fusion   = exige de tourner DANS Fusion 360 (pas de mode headless)
#   internal = calcule et écrit le STL en Python, sans Fusion — c'est ce qui
#              rend la boucle autonome
FUSION_GEOMETRY_BACKEND=auto
# Mettre à 1 pour toujours repartir du seed plutôt que du document actif.
FUSION_FORCE_SEED_IMPORT=0
# Purge avant reconstruction :
#   all    = vide entièrement le composant racine (défaut : le document est
#            dédié à l'aile, c'est le seul mode qui ne laisse aucun reliquat)
#   tagged = ne supprime que ce que le driver a marqué + les noms du seed
FUSION_PURGE_MODE=all

# --- OpenFOAM (Phase 2) --------------------------------------
# Script d'environnement OpenFOAM à sourcer avant tout run.
# Le template vise simpleFoam : OpenFOAM.com (ESI) v2212+, ou OpenFOAM.org
# jusqu'à v10. Les versions .org >= 11 ont remplacé simpleFoam par
# `foamRun -solver incompressibleFluid` — ajuster case.solver dans ce cas.
FOAM_BASHRC=/usr/lib/openfoam/openfoam2506/etc/bashrc
# Répertoire du case template.
OPENFOAM_TEMPLATE_DIR=openfoam/templates
# Nombre de cœurs pour la décomposition parallèle.
OPENFOAM_NPROCS=4

# --- Pipeline / chemins --------------------------------------
# Fichier de configuration piloté par l'agent (SEUL fichier qu'il édite).
DESIGN_PARAMS_PATH=configs/design_params.yaml
# Paramètres CFD (jamais modifiés par l'agent).
CFD_SETTINGS_PATH=configs/cfd_settings.yaml
# Racine d'archivage des itérations.
ITERATIONS_DIR=data/iterations

# --- Divers --------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
