# ─────────────────────────────────────────────────────────────
# Secrets / environnement
# ─────────────────────────────────────────────────────────────
.env
.env.local
*.key
*.pem

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─────────────────────────────────────────────────────────────
# Résultats d'itérations (lourds, régénérables)
# Seuls les fichiers de synthèse sont versionnés.
# ─────────────────────────────────────────────────────────────
# Toute serie d iterations, quel que soit son nom. Le motif ne visait que
# `data/iterations/` ; une serie nommee autrement — `data/iterations_clarky/`
# lors des essais sur profil reel — passait au travers, et 576 Mo de maillages
# OpenFOAM sont entres dans l historique sans que rien ne le signale.
data/
!data/.gitkeep
!data/iterations/.gitkeep

# ─────────────────────────────────────────────────────────────
# Dossiers livrables : ce sont des SORTIES, régénérables à volonté.
# Un exemple curé est versionné dans docs/example_report/ pour que
# le dépôt montre ce que le système produit sans rien exécuter.
# ─────────────────────────────────────────────────────────────
results/

# ─────────────────────────────────────────────────────────────
# CAO / géométrie (binaires lourds)
# ─────────────────────────────────────────────────────────────
*.f3d
*.f3z
*.step
*.stp
*.stl
*.iges
*.igs
*.obj

# ─────────────────────────────────────────────────────────────
# OpenFOAM — sorties de run
# ─────────────────────────────────────────────────────────────
openfoam/run/
openfoam/**/processor*/
openfoam/**/postProcessing/
openfoam/**/dynamicCode/
openfoam/**/*.OpenFOAM
openfoam/**/*.foam
openfoam/**/log.*
openfoam/**/*.log
# Répertoires temporels générés par le solveur (0.001, 100, 2500, ...)
# Le répertoire "0" du template reste versionné.
openfoam/templates/*/[1-9]*/
openfoam/templates/*/0.[0-9]*/

# ─────────────────────────────────────────────────────────────
# OS / éditeurs
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~
